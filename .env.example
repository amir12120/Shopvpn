# ============================================================================
# ShopVPN settings template.
#
# The installer (install.sh / the management menu) creates this file for you and
# asks for the two settings that are required below. If you install by hand:
#
#   cp .env.example .env      # then fill in BOT_TOKEN and OWNER_ID
#
# Every value can be overridden by the process environment, so the same file
# works for a systemd service, Docker or a manual run. Secrets stay out of git:
# .env is ignored, only this template is committed.
# ============================================================================

# --- Required ---------------------------------------------------------------
# Bot token from @BotFather.
BOT_TOKEN=
# Numeric Telegram id of the shop owner/admin (see @userinfobot).
OWNER_ID=

# --- Telegram update mode ---------------------------------------------------
# polling (default, no domain needed) or webhook (needs the domain below).
BOT_MODE=polling
# Only for BOT_MODE=webhook: the public https:// address nginx forwards to
# WEBHOOK_LISTEN_HOST:WEBHOOK_LISTEN_PORT.
WEBHOOK_BASE_URL=
# Random hex token Telegram echoes back in X-Telegram-Bot-Api-Secret-Token.
WEBHOOK_SECRET=
WEBHOOK_LISTEN_HOST=127.0.0.1
WEBHOOK_LISTEN_PORT=8010

# --- Optional addresses -----------------------------------------------------
# Mini App URL (must be HTTPS with a valid certificate; empty hides the button).
MINIAPP_URL=
# Base URL of the Mini App API. Derived from MINIAPP_URL when left empty.
API_BASE_URL=
# Standalone web admin panel URL (needed to build reseller panel links).
ADMIN_PANEL_URL=
# Session signing key for the standalone admin panel. Generated on install when
# empty, but then every restart logs the admins out.
ADMIN_PANEL_SECRET=

# --- Payment gateways (each bot can also store its own key in the bot panel) -
PLISIO_API_KEY=
ABANGATEWAY_API_KEY=
BLUPAL_API_KEY=
NOAPAY_API_KEY=
NOAPAY_WEBHOOK_SECRET=

# --- AI support assistant (optional; empty hides the feature) ---------------
GEMINI_API_KEY=
# Model name (alias or a pinned version, e.g. gemini-3.5-flash-lite).
AI_SUPPORT_MODEL=gemini-3.5-flash-lite
GROQ_API_KEY=
JARVIS_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=
COHERE_API_KEY=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# --- Automatic translation --------------------------------------------------
# Extra Argos languages to preload (comma separated) or "all".
SHOPVPN_TRANSLATION_LANGS=fa
# Keep 0: public providers are rate limited and can break the UI.
SHOPVPN_TRANSLATION_ALLOW_PUBLIC_APIS=0
SHOPVPN_TRANSLATION_PROVIDERS=argos
# Only used when the optional LibreTranslate fallback is installed.
SHOPVPN_LIBRETRANSLATE_URL=

# --- Web push notifications (optional) --------------------------------------
# Create a pair once with: python -m admin_panel.generate_vapid_keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIM_EMAIL=admin@example.com
