[Unit]
Description=ShopVPN isolated SSH tunnel listener for account %i
After=network.target sshd.service ssh.service

[Service]
Type=simple
ExecStart=/usr/sbin/sshd -D -f /etc/shopvpn/sshd/%i.conf
Restart=on-failure
RestartSec=2
RuntimeDirectory=sshd-shopvpn-%i
RuntimeDirectoryMode=0755
User=root
Group=root
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK

[Install]
WantedBy=multi-user.target
