[Unit]
Description=ShopVPN Linux SSH Node Agent
After=network.target

[Service]
Type=simple
EnvironmentFile=/etc/shopvpn-ssh-agent.env
ExecStart=/usr/bin/python3 /opt/shopvpn/ssh_node_agent.py
Restart=on-failure
RestartSec=3
User=root
Group=root
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ReadWritePaths=/var/lib/shopvpn-ssh-agent
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK

[Install]
WantedBy=multi-user.target
